{
  "name": "@itkdm/open-lab-components",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "version": "0.1.1",
  "description": "Zero-dependency, host-agnostic HTML fragment component library for STEM education — 210+ interactive physics, chemistry, biology, math and science components.",
  "author": "布吉岛 (https://github.com/itkdm)",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "components/**/*.html",
    "registry/registry.json",
    "registry/categories.json",
    "registry/category-names.json",
    "registry/tags.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itkdm/open-lab-components.git"
  },
  "bugs": {
    "url": "https://github.com/itkdm/open-lab-components/issues"
  },
  "homepage": "https://github.com/itkdm/open-lab-components#readme",
  "keywords": [
    "components",
    "html",
    "fragment",
    "physics",
    "chemistry",
    "biology",
    "math",
    "education",
    "stem",
    "lab",
    "apparatus",
    "interactive",
    "svg",
    "science",
    "simulation"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "validate": "node tools/validate/index.js",
    "build:registry": "node tools/build-registry/index.js",
    "build:site": "node tools/build-site/index.js",
    "check:registry": "node tools/check-registry/index.js",
    "mcp:start": "npm --prefix mcp-server start",
    "mcp:start:http": "npm --prefix mcp-server run start:http",
    "mcp:test": "npm --prefix mcp-server test",
    "mcp:test:remote": "npm --prefix mcp-server run test:remote",
    "build": "npm run build:registry && npm run build:site",
    "dev:site": "node tools/dev-site/index.js",
    "prepublishOnly": "npm run build:registry && npm run check:registry"
  },
  "devDependencies": {
    "parse5": "^7.3.0"
  }
}
